  "authors": ["Andrewwwwwwwwwwwwwww"],
  "license": "All Rights Reserved",
  "environment": "client",
  "entrypoints": {
    "client": ["io.github.andrewwwwwwwwwwwwwww.bedrocktoolbehavior.client.BedrockToolBehaviorClient"]
  },
  "mixins": [
    {
      "config": "bedrocktoolbehavior.client.mixins.json",
      "environment": "client"
    }
  ],
  "icon": "assets/bedrocktoolbehavior/icon.png",
  "contact": {
    "homepage": "https://github.com/Andrewwwwwwwwwwwwwww/bedrocktoolbehavior",
    "sources": "https://github.com/Andrewwwwwwwwwwwwwww/bedrocktoolbehavior",
    "issues": "https://github.com/Andrewwwwwwwwwwwwwww/bedrocktoolbehavior/issues"
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": ">=0.152.1",
    "minecraft": "~26.2"
  }
}
